{
  "hosting": {
    "public": "public",
    "ignore": ["**/.*"],
    "headers": [
      {"source": "**/*.@(html|js|webmanifest)", "headers": [{"key": "Cache-Control", "value": "no-cache"}]}
    ]
  },
  "firestore": {"rules": "firestore.rules"},
  "functions": [{"source": "functions", "codebase": "default", "runtime": "nodejs22", "ignore": ["node_modules", ".git", "*.log"]}]
}
