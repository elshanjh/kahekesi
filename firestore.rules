rules_version = '2';
// Only people listed in /allow (by sign-in email) can read or change anything.
// The owner is added once by the deploy workflow; the owner adds the partner from Settings.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null && request.auth.token.email_verified == true; }
    function email() { return request.auth.token.email.lower(); }
    function allowed() { return signedIn() && exists(/databases/$(database)/documents/allow/$(email())); }
    function isOwner() { return allowed() && get(/databases/$(database)/documents/allow/$(email())).data.role == 'owner'; }

    match /allow/{e} {
      allow read: if (signedIn() && e == email()) || allowed();
      allow create, update: if isOwner() && request.resource.data.role == 'member';
      allow delete: if isOwner() && resource.data.role != 'owner';
    }
    match /users/{uid} {
      allow read: if allowed();
      allow write: if allowed() && request.auth.uid == uid;
      match /tokens/{t} {
        allow read, write: if allowed() && request.auth.uid == uid;
      }
      // Private data: breaks marked private, and the cycle tracker. Only the person themselves.
      match /{sub}/{d} {
        allow read, write: if allowed() && request.auth.uid == uid && sub in ['breaks', 'periods', 'cdays', 'cyclecfg'];
      }
    }
    // Cycle summaries: everyone allowed reads them, only the person themselves writes theirs.
    match /cycle/{p} {
      allow read: if allowed();
      allow write: if allowed() && get(/databases/$(database)/documents/allow/$(email())).data.me == p;
    }
    match /{coll}/{id} {
      allow read, write: if allowed() && coll in ['items', 'rewards', 'redemptions', 'status', 'config', 'breaks', 'trips', 'wishes', 'reminders'];
    }
  }
}
